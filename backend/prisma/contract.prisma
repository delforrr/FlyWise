// use prisma-8

enum Role {
  ADMIN = "ADMIN"
  OPERATOR = "OPERATOR"
}

enum FlightStatus {
  ARRIVED = "ARRIVED"
  CANCELLED = "CANCELLED"
  DIVERTED = "DIVERTED"
}

enum EtlTargetEntity {
  paises = "paises"
  aerolineas = "aerolineas"
  aeropuertos = "aeropuertos"
  rutas = "rutas"
  otp_metrics = "otp_metrics"
}

enum EtlLogLevel {
  info = "info"
  success = "success"
  warn = "warn"
  error = "error"
}

model Usuario {
  id            String   @id @onCreate(uuid())
  correo         String   @unique
  hashContrasena  String   @map("hash_contrasena")
  rol          Role     @default(OPERATOR)
  creadoEn     TimestampString(3) @default(now()) @map("creado_en")
  actualizadoEn     TimestampString(3) @onCreate(now()) @onUpdate(now()) @map("actualizado_en")
  ejecucionesSolicitadas EjecucionEtl[]

  // PostgreSQL btrim's default is ASCII space; this set matches JavaScript String.trim.
  @@check(expression: sql`((correo = lower(btrim(correo, ((((((((((((((((((((((((chr(9) || chr(10)) || chr(11)) || chr(12)) || chr(13)) || chr(32)) || chr(160)) || chr(5760)) || chr(8192)) || chr(8193)) || chr(8194)) || chr(8195)) || chr(8196)) || chr(8197)) || chr(8198)) || chr(8199)) || chr(8200)) || chr(8201)) || chr(8202)) || chr(8232)) || chr(8233)) || chr(8239)) || chr(8287)) || chr(12288)) || chr(65279))))) AND (correo <> ''::text))`, map: "users_email_canonical_check")
  @@map("usuarios")
}

model Pais {
  id       String    @id @onCreate(uuid())
  nombre     String    @unique
  codigoIso  String?   @map("codigo_iso")
  aeropuertos Aeropuerto[]
  aerolineas Aerolinea[]

  @@check(expression: sql`(nombre ~ '[^[:space:]]'::text)`, map: "countries_name_check")
  @@check(expression: sql`((codigo_iso IS NULL) OR (codigo_iso ~ '^[A-Z]{2}$'::text))`, map: "countries_iso_check")
  @@map("paises")
}

model Aeropuerto {
  archivadoEn TimestampString(3)? @map("archivado_en")
  protegidoManualmente Boolean @default(false) @map("protegido_manualmente")
  vinculoPaisInferido Boolean @default(false) @map("vinculo_pais_inferido")
  id            String                                @id @onCreate(uuid())
  idOpenflights Int?                                  @unique @map("id_openflights")
  nombre          String
  ciudad          String?
  nombrePais   String                                @map("nombre_pais")
  paisId     String?                               @map("pais_id")
  pais       Pais?                              @relation(fields: [paisId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  iata          String?                               @map("iata")
  icao          String?                               @map("icao")
  latitud      Float
  longitud     Float
  // SQL trigger maintains WGS 84 coordenadas for all import paths.
  ubicacion      Raw(sql`geography(Point,4326)`)?
  fuente        String?                               @default("OurAirports/OpenFlights")
  cantidadRutas    Int                                   @default(0) @map("cantidad_rutas")

  rutasOrigen       Ruta[]       @relation("OriginAirport")
  rutasDestino  Ruta[]       @relation("DestinationAirport")
  vuelosSalida   Vuelo[]      @relation("FlightOrigin")
  vuelosLlegada    Vuelo[]      @relation("FlightDestination")
  metricasOrigen      MetricaRuta[] @relation("MetricOrigin")
  metricasDestino MetricaRuta[] @relation("MetricDestination")

  @@index([ubicacion], type: "gist", map: "airports_location_idx")
  @@index([iata], map: "airports_iata_idx")
  @@index([icao], map: "airports_icao_idx")
  @@index([nombrePais], map: "airports_country_name_idx")
  @@index([paisId], map: "airports_country_id_idx")
  @@check(expression: sql`(ubicacion IS NOT NULL)`, map: "airports_location_check")
  @@check(expression: sql`(cantidad_rutas >= 0)`, map: "airports_route_count_check")
  @@check(expression: sql`(((latitud >= ('-90'::integer)::double precision) AND (latitud <= (90)::double precision)) AND ((longitud >= ('-180'::integer)::double precision) AND (longitud <= (180)::double precision)))`, name: "valid_airport_coordinates")
  @@check(expression: sql`((nombre ~ '[^[:space:]]'::text) AND (nombre_pais ~ '[^[:space:]]'::text))`, map: "airports_name_check")
  @@check(expression: sql`(((iata IS NULL) OR (iata ~ '^[A-Z]{3}$'::text)) AND ((icao IS NULL) OR (icao ~ '^[A-Z0-9]{4}$'::text)))`, map: "airports_codes_check")
  @@map("aeropuertos")
}

model Aerolinea {
  fuente String @default("OpenFlights")
  archivadoEn TimestampString(3)? @map("archivado_en")
  protegidoManualmente Boolean @default(false) @map("protegido_manualmente")
  vinculoPaisInferido Boolean @default(false) @map("vinculo_pais_inferido")
  id            String   @id @onCreate(uuid())
  idOpenflights Int?     @unique @map("id_openflights")
  nombre          String
  iata          String?  @map("iata")
  icao          String?  @map("icao")
  pais       String?
  paisId     String?  @map("pais_id")
  registroPais Pais? @relation(fields: [paisId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activa        Boolean?

  ofertas  OfertaRuta[]
  vuelos Vuelo[]
  metricas MetricaRuta[]

  @@index([iata], map: "airlines_iata_idx")
  @@index([icao], map: "airlines_icao_idx")
  @@index([paisId], map: "airlines_country_id_idx")
  @@check(expression: sql`(nombre ~ '[^[:space:]]'::text)`, map: "airlines_name_check")
  @@check(expression: sql`(((iata IS NULL) OR (iata ~ '^[A-Z0-9]{2}$'::text)) AND ((icao IS NULL) OR (icao ~ '^[A-Z0-9]{3}$'::text)))`, map: "airlines_codes_check")
  @@map("aerolineas")
}

model Ruta {
  id String @id @onCreate(uuid())
  origenId String @map("origen_id")
  destinoId String @map("destino_id")
  archivadoEn TimestampString(3)? @map("archivado_en")
  protegidoManualmente Boolean @default(false) @map("protegido_manualmente")
  origen Aeropuerto @relation("OriginAirport", fields: [origenId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: "rutas_extremos_key")
  destino Aeropuerto @relation("DestinationAirport", fields: [destinoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ofertas OfertaRuta[]
  @@unique([origenId, destinoId], map: "rutas_extremos_key")
  @@index([destinoId], map: "rutas_destino_idx")
  @@check(expression: sql`(origen_id <> destino_id)`, map: "rutas_extremos_check")
  @@map("rutas")
}

model OfertaRuta {
  id String @id @onCreate(uuid())
  rutaId String @map("ruta_id")
  aerolineaId String? @map("aerolinea_id")
  codigoAerolinea String? @map("codigo_aerolinea")
  codigoCompartido Boolean @default(false) @map("codigo_compartido")
  escalas Int @default(0)
  fuente String @default("OpenFlights")
  claveImportacion String? @unique @map("clave_importacion")
  archivadoEn TimestampString(3)? @map("archivado_en")
  protegidoManualmente Boolean @default(false) @map("protegido_manualmente")
  ruta Ruta @relation(fields: [rutaId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: "ofertas_ruta_identidad_key")
  aerolinea Aerolinea? @relation(fields: [aerolineaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@unique([rutaId, aerolineaId, codigoAerolinea, codigoCompartido, escalas], map: "ofertas_ruta_identidad_key")
  @@index([aerolineaId], map: "routes_airline_id_idx")
  @@check(expression: sql`(escalas >= 0)`, map: "routes_stops_check")
  @@check(expression: sql`((codigo_aerolinea IS NULL) OR (codigo_aerolinea ~ '^[A-Z0-9]{2,3}$'::text))`, map: "routes_airline_code_check")
  @@map("ofertas_ruta")
}

model EjecucionEtl {
  intento               Int                  @default(0)
  id                    String               @id @onCreate(uuid())
  fuente                String               @map("fuente")
  estado                String               @map("estado")
  filasTotales             Int                  @default(0) @map("filas_totales")
  filasProcesadas         Int                  @default(0) @map("filas_procesadas")
  filasInsertadas          Int                  @default(0) @map("filas_insertadas")
  filasDescartadas         Int                  @default(0) @map("filas_descartadas")
  iniciadoEn             TimestampString(3)?            @map("iniciado_en")
  finalizadoEn            TimestampString(3)?            @map("finalizado_en")
  mensajeError          String?              @map("mensaje_error")
  vuelos               Vuelo[]
  metricas             MetricaRuta[]
  procesoId            String?              @map("proceso_id")
  solicitanteId         String?              @map("solicitante_id")
  instantaneaConfiguracion Jsonb?                @map("instantanea_configuracion")
  uriFuente             String?              @map("uri_fuente")
  checksumFuente        String?              @map("checksum_fuente")
  proceso              ProcesoEtl?         @relation(fields: [procesoId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: "etl_jobs_pipeline_id_started_at_idx")
  solicitante           Usuario?                @relation(fields: [solicitanteId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  muestrasDescartadas      MuestraDescartadaEtl[]
  eventos                EventoEjecucionEtl[]

  @@index([fuente, estado], map: "etl_jobs_source_status_idx")
  @@index([procesoId, iniciadoEn], map: "etl_jobs_pipeline_id_started_at_idx")
  @@index([solicitanteId], map: "etl_jobs_requested_by_id_idx")
  @@check(expression: sql`((finalizado_en IS NULL) OR ((iniciado_en IS NOT NULL) AND (finalizado_en >= iniciado_en)))`, map: "etl_jobs_timestamps_check")
  @@check(expression: sql`((estado <> 'completed'::text) OR ((iniciado_en IS NOT NULL) AND (finalizado_en IS NOT NULL) AND ((filas_totales)::bigint = ((filas_procesadas)::bigint + filas_descartadas))))`, map: "etl_jobs_completion_check")
  @@check(expression: sql`((filas_totales >= 0) AND (filas_procesadas >= 0) AND (filas_descartadas >= 0) AND (filas_insertadas >= 0) AND (filas_insertadas <= filas_procesadas) AND (((filas_procesadas)::bigint + filas_descartadas) <= filas_totales))`, map: "etl_jobs_rows_check")
  @@check(expression: sql`(estado = ANY (ARRAY['pending'::text, 'running'::text, 'completed'::text, 'failed'::text]))`, map: "etl_jobs_status_check")
  @@check(expression: sql`((uri_fuente IS NULL) OR ((length(btrim(uri_fuente)) > 0) AND (uri_fuente !~ '://[^/]*@|[?#]'::text)))`, map: "etl_jobs_source_uri_check")
  @@check(expression: sql`((checksum_fuente IS NULL) OR (checksum_fuente ~ '^[0-9a-fA-F]{64}$'::text))`, map: "etl_jobs_checksum_check")
  @@check(expression: sql`(((instantanea_configuracion IS NULL) AND (proceso_id IS NULL)) OR (((jsonb_typeof(instantanea_configuracion) = 'object'::text) AND ((instantanea_configuracion - ARRAY['conexion'::text, 'mapeoEsquema'::text, 'configuracionProgramacion'::text]) = '{}'::jsonb) AND etl_valid_connection((instantanea_configuracion -> 'conexion'::text)) AND etl_valid_mapping((instantanea_configuracion -> 'mapeoEsquema'::text)) AND etl_valid_schedule((instantanea_configuracion -> 'configuracionProgramacion'::text))) IS TRUE))`, map: "etl_jobs_snapshot_check")
  @@map("ejecuciones_etl")
  @@check(expression: sql`(intento >= 0)`, map: "etl_jobs_attempt_check")
}

model ProcesoEtl {
  id             String          @id @onCreate(uuid())
  nombre           String
  nombreConjunto    String          @map("nombre_conjunto")
  descripcion    String          @default("")
  entidadDestino   EtlTargetEntity @map("entidad_destino")
  esSistema       Boolean         @default(false) @map("es_sistema")
  pausado         Boolean         @default(false)
  conexion     Jsonb
  mapeoEsquema  Jsonb            @map("mapeo_esquema")
  configuracionProgramacion Jsonb            @map("configuracion_programacion")
  archivadoEn     TimestampString(3)?       @map("archivado_en")
  creadoEn      TimestampString(3)        @default(now()) @map("creado_en")
  actualizadoEn      TimestampString(3)        @onCreate(now()) @onUpdate(now()) @map("actualizado_en")
  ejecuciones           EjecucionEtl[]

  @@index([archivadoEn, pausado], map: "etl_pipelines_archived_at_paused_idx")
  @@check(expression: sql`(etl_valid_mapping(mapeo_esquema) IS TRUE)`, map: "etl_pipelines_mapping_check")
  @@check(expression: sql`(etl_valid_schedule(configuracion_programacion) IS TRUE)`, map: "etl_pipelines_schedule_check")
  @@check(expression: sql`(etl_valid_connection(conexion) IS TRUE)`, map: "etl_pipelines_connection_check")
  @@check(expression: sql`((length(btrim(nombre)) > 0) AND (length(btrim(nombre_conjunto)) > 0))`, map: "etl_pipelines_identity_check")
  @@map("procesos_etl")
}

model MuestraDescartadaEtl {
  intento   Int      @default(0)
  id        String   @id @onCreate(uuid())
  ejecucionId     String   @map("ejecucion_id")
  numeroFila  Int      @map("numero_fila")
  campo     String?
  motivo    String
  muestraOriginal VarChar(4096)   @map("muestra_original")
  creadoEn TimestampString(3) @default(now()) @map("creado_en")
  job       EjecucionEtl   @relation(fields: [ejecucionId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: "etl_discarded_samples_job_id_row_index_idx")

  @@index([ejecucionId, numeroFila], map: "etl_discarded_samples_job_id_row_index_idx")
  @@check(expression: sql`(length(btrim(motivo)) > 0)`, map: "etl_discarded_samples_reason_check")
  @@check(expression: sql`(numero_fila > 0)`, map: "etl_discarded_samples_row_check")
  @@map("muestras_descartadas_etl")
  @@check(expression: sql`(intento >= 0)`, map: "etl_discarded_samples_attempt_check")
}

model EventoEjecucionEtl {
  intento   Int      @default(0)
  id        String      @id @onCreate(uuid())
  ejecucionId     String      @map("ejecucion_id")
  nivel     EtlLogLevel
  mensaje   String
  creadoEn TimestampString(3)    @default(now()) @map("creado_en")
  job       EjecucionEtl      @relation(fields: [ejecucionId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: "etl_job_events_job_id_created_at_idx")

  @@index([ejecucionId, creadoEn], map: "etl_job_events_job_id_created_at_idx")
  @@check(expression: sql`(length(btrim(mensaje)) > 0)`, map: "etl_job_events_message_check")
  @@map("eventos_ejecucion_etl")
  @@check(expression: sql`(intento >= 0)`, map: "etl_job_events_attempt_check")
}

// One fuente record per flight operation; idRegistroFuente must survive retries.
model Vuelo {
  id                  String       @id @onCreate(uuid())
  fuente              String
  idRegistroFuente      String       @map("id_registro_fuente")
  fechaVuelo          DateString     @map("fecha_vuelo")
  numeroVuelo        String       @map("numero_vuelo")
  origenId            String       @map("origen_id")
  destinoId       String       @map("destino_id")
  aerolineaId           String       @map("aerolinea_id")
  estado              FlightStatus
  demoraLlegadaMinutos Int?         @map("demora_llegada_minutos")
  ejecucionEtlId            String      @map("ejecucion_etl_id")

  origen      Aeropuerto @relation("FlightOrigin", fields: [origenId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: "flights_origin_id_destination_id_airline_id_flight_date_idx")
  destino Aeropuerto @relation("FlightDestination", fields: [destinoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aerolinea     Aerolinea @relation(fields: [aerolineaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ejecucionEtl      EjecucionEtl @relation(fields: [ejecucionEtlId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([fuente, idRegistroFuente])
  @@index([origenId, destinoId, aerolineaId, fechaVuelo], map: "flights_origin_id_destination_id_airline_id_flight_date_idx")
  @@index([fechaVuelo], map: "flights_flight_date_idx")
  @@index([destinoId], map: "flights_destination_id_idx")
  @@index([aerolineaId], map: "flights_airline_id_idx")
  @@index([ejecucionEtlId], map: "flights_etl_job_id_idx")
  @@check(expression: sql`(((estado = 'ARRIVED'::text) AND (demora_llegada_minutos IS NOT NULL)) OR ((estado <> 'ARRIVED'::text) AND (demora_llegada_minutos IS NULL)))`, map: "flights_arrival_delay_check")
  @@check(expression: sql`(origen_id <> destino_id)`, map: "flights_endpoints_check")
  @@check(expression: sql`((length(TRIM(BOTH FROM fuente)) > 0) AND (length(TRIM(BOTH FROM id_registro_fuente)) > 0) AND (length(TRIM(BOTH FROM numero_vuelo)) > 0))`, map: "flights_source_check")
  @@map("vuelos")
}

// Monthly counters: percentages are derived, never averaged across months.
model MetricaRuta {
  ejecucionEtlId String @map("ejecucion_etl_id")
  ejecucionEtl EjecucionEtl @relation(fields: [ejecucionEtlId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([ejecucionEtlId], map: "metricas_ruta_ejecucion_etl_idx")
  origenId                 String   @map("origen_id")
  destinoId            String   @map("destino_id")
  aerolineaId                String   @map("aerolinea_id")
  periodo                   DateString
  vuelosTotales             Int      @map("vuelos_totales")
  vuelosCancelados         Int      @default(0) @map("vuelos_cancelados")
  vuelosDesviados          Int      @default(0) @map("vuelos_desviados")
  vuelosPuntuales            Int      @default(0) @map("vuelos_puntuales")
  demoraLlegadaTotalMinutos BigInt   @default(0) @map("demora_llegada_total_minutos")
  actualizadoEn                TimestampString(3) @onCreate(now()) @onUpdate(now()) @map("actualizado_en")

  origen      Aeropuerto @relation("MetricOrigin", fields: [origenId], references: [id], onDelete: Restrict, onUpdate: Cascade, index: false)
  destino Aeropuerto @relation("MetricDestination", fields: [destinoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aerolinea     Aerolinea @relation(fields: [aerolineaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([origenId, destinoId, aerolineaId, periodo])
  @@index([periodo], map: "route_metrics_period_idx")
  @@index([destinoId], map: "route_metrics_destination_id_idx")
  @@index([aerolineaId], map: "route_metrics_airline_id_idx")
  @@check(expression: sql`((vuelos_totales > ((vuelos_cancelados)::bigint + vuelos_desviados)) OR (demora_llegada_total_minutos = 0))`, map: "route_metrics_delay_check")
  @@check(expression: sql`((vuelos_totales >= 0) AND (vuelos_cancelados >= 0) AND (vuelos_desviados >= 0) AND (vuelos_puntuales >= 0) AND ((((vuelos_cancelados)::bigint + vuelos_desviados) + vuelos_puntuales) <= vuelos_totales))`, map: "route_metrics_counts_check")
  @@check(expression: sql`(EXTRACT(day FROM periodo) = (1)::numeric)`, map: "route_metrics_period_check")
  @@check(expression: sql`(origen_id <> destino_id)`, map: "route_metrics_endpoints_check")
  @@map("metricas_ruta")
}
