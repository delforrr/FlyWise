datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, fuzzystrmatch, postgis_tiger_geocoder, postgis_topology]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  ADMIN
  OPERATOR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  isoCode   String?  @map("iso_code")
  dafifCode String?  @map("dafif_code")

  @@map("countries")
}

model Airport {
  id             String   @id @default(uuid())
  openflightsId  Int?     @unique @map("openflights_id")
  name           String
  city           String?
  countryName    String   @map("country_name")
  iata           String?  @map("iata")
  icao           String?  @map("icao")
  latitude       Float
  longitude      Float
  altitudeFt     Int?     @map("altitude_ft")
  timezoneOffset Float?   @map("timezone_offset")
  dst            String?
  tzDatabase     String?  @map("tz_database")
  type           String?  @default("airport")
  source         String?  @default("OurAirports/OpenFlights")
  routeCount     Int      @default(0) @map("route_count")
  createdAt      DateTime @default(now()) @map("created_at")

  originRoutes      Route[]  @relation("OriginAirport")
  destinationRoutes Route[]  @relation("DestinationAirport")

  @@index([iata])
  @@index([icao])
  @@index([countryName])
  @@map("airports")
}

model Airline {
  id            String   @id @default(uuid())
  openflightsId Int?     @unique @map("openflights_id")
  name          String
  alias         String?
  iata          String?  @map("iata")
  icao          String?  @map("icao")
  callsign      String?
  country       String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  routes Route[]

  @@index([iata])
  @@index([icao])
  @@map("airlines")
}

model Route {
  id               String   @id @default(uuid())
  airlineCode      String?  @map("airline_code")
  airlineId        String?  @map("airline_id")
  originIata       String   @map("origin_iata")
  originId         String   @map("origin_id")
  destinationIata  String   @map("destination_iata")
  destinationId    String   @map("destination_id")
  codeshare        Boolean  @default(false)
  stops            Int      @default(0)
  equipment        String?
  distanceKm       Float?   @map("distance_km")
  distanceNm       Float?   @map("distance_nm")
  popularityScore  Float    @default(0) @map("popularity_score")
  isTop100         Boolean  @default(false) @map("is_top_100")
  createdAt        DateTime @default(now()) @map("created_at")

  airline     Airline? @relation(fields: [airlineId], references: [id], onDelete: SetNull)
  origin      Airport  @relation("OriginAirport", fields: [originId], references: [id], onDelete: Cascade)
  destination Airport  @relation("DestinationAirport", fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([originId, destinationId])
  @@index([originIata])
  @@index([destinationIata])
  @@index([isTop100])
  @@map("routes")
}

model EtlJob {
  id            String    @id @default(uuid())
  source        String    @map("source")
  status        String    @map("status")
  totalRows     Int       @default(0) @map("total_rows")
  processedRows Int       @default(0) @map("processed_rows")
  discardedRows Int       @default(0) @map("discarded_rows")
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  durationMs    Int?      @map("duration_ms")
  errorMessage  String?   @map("error_message")

  @@index([source, status])
  @@map("etl_jobs")
}
