classDiagram
    %% Vista simplificada: identificadores originales y descripciones en español.
    %% PK = clave primaria; FK = clave foránea; UK = valor único.
    País "0..1" -- "0..*" Aeropuerto : agrupa
    País "0..1" -- "0..*" Aerolínea : agrupa
    Usuario "0..1" -- "0..*" EventoEtl : solicita
    PipelineEtl "0..1" -- "0..*" EventoEtl : genera
    EventoEtl "1" -- "0..*" FilaDescartadaEtl : contiene
    EventoEtl "1" -- "0..*" EjecuciónEventoEtl : registra
    Aeropuerto "1" -- "0..*" Ruta : origen
    Aeropuerto "1" -- "0..*" Ruta : destino
    Aerolínea "0..1" -- "0..*" Ruta : opera
    Aeropuerto "1" -- "0..*" Vuelo : origen
    Aeropuerto "1" -- "0..*" Vuelo : destino
    Aerolínea "1" -- "0..*" Vuelo : opera
    EventoEtl "0..1" -- "0..*" Vuelo : incorpora
    Aeropuerto "1" -- "0..*" MétricasRuta : origen
    Aeropuerto "1" -- "0..*" MétricasRuta : destino
    Aerolínea "1" -- "0..*" MétricasRuta : opera

    class Usuario {
        +string id
        +string email
        +Role role
    }
    class País {
        +string id
        +string name
        +string isoCode
    }
    class Aeropuerto {
        +string id
        +string name
        +string countryId
        +float latitude
        +float longitude
    }
    class Aerolínea {
        +string id
        +string name
        +string countryId
    }
    class Ruta {
        +string id
        +string originId
        +string destinationId
        +string airlineId
        +int stops
    }
    %% Flight y RouteMetric: carga y agregación aún no activadas.
    class Vuelo {
        +string id
        +date flightDate
        +string originId
        +string destinationId
        +string airlineId
        +string etlJobId
        +FlightStatus status
        +int arrivalDelayMinutes
    }
    class MétricasRuta {
        +string originId
        +string destinationId
        +string airlineId
        +date period
        +int totalFlights
        +int cancelledFlights
        +int divertedFlights
        +int onTimeFlights
        +bigint totalArrivalDelayMinutes
    }
    class PipelineEtl {
        +string id
        +string name
        +EtlTargetEntity targetEntity
        +boolean paused
    }
    class EventoEtl {
        +string id
        +string pipelineId
        +string requestedById
        +string status
        +int totalRows
        +int processedRows
        +int discardedRows
    }
    class FilaDescartadaEtl {
        +string id
        +string jobId
        +int rowIndex
        +string reason
        +string rawSample
     }
    class EjecuciónEventoEtl {
        +string id
        +string jobId
        +EtlLogLevel level
        +string message
    }
    
