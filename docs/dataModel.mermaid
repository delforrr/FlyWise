classDiagram
    %% Vista simplificada: identificadores originales y descripciones en español.
    %% PK = clave primaria; FK = clave foránea; UK = valor único.
    Country "0..1" -- "0..*" Airport : agrupa
    Country "0..1" -- "0..*" Airline : agrupa
    User "0..1" -- "0..*" EtlJob : solicita
    EtlPipeline "0..1" -- "0..*" EtlJob : genera
    EtlJob "1" -- "0..*" EtlDiscardedSample : contiene
    EtlJob "1" -- "0..*" EtlJobEvent : registra
    Airport "1" -- "0..*" Route : origen
    Airport "1" -- "0..*" Route : destino
    Airline "0..1" -- "0..*" Route : opera
    Airport "1" -- "0..*" Flight : origen
    Airport "1" -- "0..*" Flight : destino
    Airline "1" -- "0..*" Flight : opera
    EtlJob "0..1" -- "0..*" Flight : incorpora
    Airport "1" -- "0..*" RouteMetric : origen
    Airport "1" -- "0..*" RouteMetric : destino
    Airline "1" -- "0..*" RouteMetric : opera

    class User {
        +string id
        +string email
        +Role role
    }
    note for User "id: PK\nemail: UK"
    class Country {
        +string id
        +string name
        +string isoCode
    }
    note for Country "id: PK\nname: UK\nisoCode: opcional"
    class Airport {
        +string id
        +string name
        +string countryId
        +float latitude
        +float longitude
    }
    note for Airport "id: PK\ncountryId: FK opcional"
    class Airline {
        +string id
        +string name
        +string countryId
    }
    note for Airline "id: PK\ncountryId: FK opcional"
    class Route {
        +string id
        +string originId
        +string destinationId
        +string airlineId
        +int stops
    }
    note for Route "id: PK\noriginId: FK\ndestinationId: FK\nairlineId: FK opcional"
    %% Flight y RouteMetric: carga y agregación aún no activadas.
    class Flight {
        +string id
        +date flightDate
        +string originId
        +string destinationId
        +string airlineId
        +string etlJobId
        +FlightStatus status
        +int arrivalDelayMinutes
    }
    note for Flight "id: PK\noriginId: FK\ndestinationId: FK\nairlineId: FK\netlJobId: FK opcional\nstatus: aterrizado, cancelado o desviado\narrivalDelayMinutes: solo si aterrizó"
    class RouteMetric {
        +string originId
        +string destinationId
        +string airlineId
        +date period
        +int totalFlights
        +int cancelledFlights
        +int divertedFlights
        +int onTimeFlights
        +bigint totalArrivalDelayMinutes
    }
    note for RouteMetric "originId: PK, FK\ndestinationId: PK, FK\nairlineId: PK, FK\nperiod: PK primer día del mes"
    class EtlPipeline {
        +string id
        +string name
        +EtlTargetEntity targetEntity
        +boolean paused
    }
    note for EtlPipeline "id: PK\ntargetEntity: países, aeropuertos, aerolíneas, rutas o métricas"
    class EtlJob {
        +string id
        +string pipelineId
        +string requestedById
        +string status
        +int totalRows
        +int processedRows
        +int discardedRows
    }
    note for EtlJob "id: PK\npipelineId: FK opcional\nrequestedById: FK opcional\nstatus: pendiente, en curso, completada o fallida"
    class EtlDiscardedSample {
        +string id
        +string jobId
        +int rowIndex
        +string reason
        +string rawSample
    }
    note for EtlDiscardedSample "id: PK\njobId: FK"
    class EtlJobEvent {
        +string id
        +string jobId
        +EtlLogLevel level
        +string message
    }
    note for EtlJobEvent "id: PK\njobId: FK\nlevel: información, éxito, advertencia o error"
