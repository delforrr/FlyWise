classDiagram
    %% Vista del modelo implementado. PK y restricciones completas en contract.prisma.
    Pais "0..1" -- "0..*" Aeropuerto : agrupa
    Pais "0..1" -- "0..*" Aerolinea : agrupa
    Usuario "0..1" -- "0..*" EjecucionEtl : solicita
    ProcesoEtl "0..1" -- "0..*" EjecucionEtl : genera
    EjecucionEtl "1" -- "0..*" MuestraDescartadaEtl : contiene
    EjecucionEtl "1" -- "0..*" EventoEjecucionEtl : registra
    Aeropuerto "1" -- "0..*" Ruta : origen
    Aeropuerto "1" -- "0..*" Ruta : destino
    Ruta "1" -- "0..*" OfertaRuta : ofrece
    Aerolinea "0..1" -- "0..*" OfertaRuta : opera
    Aeropuerto "1" -- "0..*" Vuelo : origen
    Aeropuerto "1" -- "0..*" Vuelo : destino
    Aerolinea "1" -- "0..*" Vuelo : opera
    EjecucionEtl "1" -- "0..*" Vuelo : incorpora
    Aeropuerto "1" -- "0..*" MetricaRuta : origen
    Aeropuerto "1" -- "0..*" MetricaRuta : destino
    Aerolinea "1" -- "0..*" MetricaRuta : opera
    EjecucionEtl "1" -- "0..*" MetricaRuta : calcula

    class Usuario {
        +string id
        +string correo
        +Role rol
    }
    class Pais {
        +string id
        +string nombre
        +string codigoIso
    }
    class Aeropuerto {
        +string id
        +int idOpenflights
        +string nombre
        +string paisId
        +float latitud
        +float longitud
        +timestamp archivadoEn
        +boolean protegidoManualmente
    }
    class Aerolinea {
        +string id
        +int idOpenflights
        +string nombre
        +string paisId
        +timestamp archivadoEn
        +boolean protegidoManualmente
    }
    class Ruta {
        +string id
        +string origenId
        +string destinoId
        +timestamp archivadoEn
    }
    class OfertaRuta {
        +string id
        +string rutaId
        +string aerolineaId
        +string codigoAerolinea
        +boolean codigoCompartido
        +int escalas
        +string fuente
        +string claveImportacion
        +timestamp archivadoEn
        +boolean protegidoManualmente
    }
    %% Vuelo y MetricaRuta: importación operacional y agregación aún no activadas.
    class Vuelo {
        +string id
        +string fuente
        +string idRegistroFuente
        +date fechaVuelo
        +string origenId
        +string destinoId
        +string aerolineaId
        +string ejecucionEtlId
        +FlightStatus estado
        +int demoraLlegadaMinutos
    }
    class MetricaRuta {
        +string origenId
        +string destinoId
        +string aerolineaId
        +date periodo
        +string ejecucionEtlId
        +int vuelosTotales
        +int vuelosCancelados
        +int vuelosDesviados
        +int vuelosPuntuales
        +bigint demoraLlegadaTotalMinutos
    }
    class ProcesoEtl {
        +string id
        +string nombre
        +EtlTargetEntity entidadDestino
        +boolean pausado
    }
    class EjecucionEtl {
        +string id
        +string procesoId
        +string solicitanteId
        +string estado
        +int filasTotales
        +int filasProcesadas
        +int filasDescartadas
    }
    class MuestraDescartadaEtl {
        +string id
        +string ejecucionId
        +int numeroFila
        +string motivo
        +string muestraOriginal
    }
    class EventoEjecucionEtl {
        +string id
        +string ejecucionId
        +EtlLogLevel nivel
        +string mensaje
    }
